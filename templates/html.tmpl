<style>
    /* Tables (from blog) */
    table {
        border-spacing: 0;
    }

    th, td {
        padding: 0.5em;
    }

    th {
        text-align: left;
        border-bottom: 1px solid black;
    }

    .poem-diff {
        text-decoration: underline;
    }
</style>    
<table>
    <thead>
        <tr>
        {{ range . }}<th>{{.Title}}</th>{{ end }}
        </tr>
    </thead>
    <tbody>
        <tr>
        {{ range . }}
            <td>{{.Text}}</td>
        {{ end }}
        </tr>
</table>
